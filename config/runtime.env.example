# Copy to a machine-local environment file or configure these in the server's
# secret/config manager. Never commit the real file.

# Local example: /Users/<name>/ira-runtime
# Server example: /srv/ira
IRA_RUNTIME_ROOT=/srv/ira

# Versioned resources normally stay in the repository. Override only when the
# deployment mounts prompts/policies/schemas from a separate release bundle.
# IRA_RESOURCE_ROOT=/app/resources

# Optional per-store overrides. Leave unset to derive them from IRA_RUNTIME_ROOT.
# IRA_MANUAL_SOURCE_ROOT=/mnt/research/manual
# IRA_EXTERNAL_SOURCE_ROOT=s3-mounted-path-or-local-directory
# IRA_DERIVED_ROOT=/srv/ira/derived
# IRA_ARTIFACT_ROOT=/srv/ira/artifacts
# IRA_SQLITE_PATH=/srv/ira/stores/relational/ira.db
# IRA_LANCE_PATH=/srv/ira/stores/vector/lancedb_root
# IRA_KUZU_PATH=/srv/ira/stores/graph/kuzu_root.db

IRA_ENV=production
PYTHONUNBUFFERED=1
IRA_MCP_HOST=0.0.0.0
IRA_MCP_PORT=8000

# Secrets belong in the deployment secret manager, not this file. The supplied
# Compose stack reads them from IRA_SECRETS_DIR; these environment forms remain
# available for local stdio clients.
# ANTHROPIC_API_KEY=
# ANTHROPIC_BASE_URL=https://api.anthropic.com
# TUSHARE_TOKEN=
# IRA_MCP_TOKEN=replace-with-a-long-random-token
