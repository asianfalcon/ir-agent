# Copy to a machine-local environment file or configure these in the server's
# secret/config manager. Never commit the real file.

# Local example: /Users/<name>/alphasonar-runtime
# Server example: /srv/alphasonar
ALPHASONAR_RUNTIME_ROOT=/srv/alphasonar

# Versioned resources normally stay in the repository. Override only when the
# deployment mounts prompts/policies/schemas from a separate release bundle.
# ALPHASONAR_RESOURCE_ROOT=/app/resources

# Optional per-store overrides. Leave unset to derive them from ALPHASONAR_RUNTIME_ROOT.
# ALPHASONAR_MANUAL_SOURCE_ROOT=/mnt/research/manual
# ALPHASONAR_EXTERNAL_SOURCE_ROOT=s3-mounted-path-or-local-directory
# ALPHASONAR_DERIVED_ROOT=/srv/alphasonar/derived
# ALPHASONAR_ARTIFACT_ROOT=/srv/alphasonar/artifacts
# ALPHASONAR_SQLITE_PATH=/srv/alphasonar/stores/relational/alphasonar.db
# ALPHASONAR_LANCE_PATH=/srv/alphasonar/stores/vector/lancedb_root
# ALPHASONAR_KUZU_PATH=/srv/alphasonar/stores/graph/kuzu_root.db

ALPHASONAR_ENV=production
PYTHONUNBUFFERED=1
ALPHASONAR_MCP_HOST=0.0.0.0
ALPHASONAR_MCP_PORT=8000

# Secrets belong in the deployment secret manager, not this file. The supplied
# Compose stack reads them from ALPHASONAR_SECRETS_DIR; these environment forms remain
# available for local stdio clients.
# ANTHROPIC_API_KEY=
# ANTHROPIC_BASE_URL=https://api.anthropic.com
# TUSHARE_TOKEN=
# ALPHASONAR_MCP_TOKEN=replace-with-a-long-random-token

# Compose file-secret names under ALPHASONAR_SECRETS_DIR:
# anthropic_api_key | tushare_token | alphasonar_mcp_token
