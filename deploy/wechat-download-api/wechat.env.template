# Copy this file to wechat.env. The runtime file is intentionally gitignored.

# Login credentials are written to deploy/wechat-download-api/data/ after QR login.
WECHAT_TOKEN=
WECHAT_COOKIE=
WECHAT_FAKEID=
WECHAT_NICKNAME=
WECHAT_EXPIRE_TIME=

# Conservative defaults reduce account/IP risk. Increase only after observing stability.
RATE_LIMIT_GLOBAL=6
RATE_LIMIT_PER_IP=3
RATE_LIMIT_ARTICLE_INTERVAL=5

RSS_POLL_INTERVAL=3600
ARTICLES_PER_POLL=5
RSS_FETCH_FULL_CONTENT=true
PROXY_URLS=

SITE_URL=http://127.0.0.1:5000
PORT=5000
HOST=0.0.0.0
DEBUG=false

# Optional built-in MCP. Keep disabled until MCP_TOKEN is set to a long random value.
ENABLE_MCP=0
MCP_TOKEN=
